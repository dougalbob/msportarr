__pycache__/
*.pyc
*.pyo
.env
*.log
config/grabber_state.json

# Runtime state written into the repo when the app is run from a checkout
# (tests, local dev). None of it belongs in git.
config/webui_settings.json
config/watcher_state.json
config/activity_events.json
config/discord_rate_limit.json
config/release_mismatches.json
config/release_mismatches.lock
# Every other sidecar lock and single-writer state file a checkout produces:
# they are runtime artefacts, and committing one is worse than ignoring it
# because a tracked file survives `docker build`'s context rules.
config/*.lock
config/background_health.json
config/scheduler_plan.json
config/submission_intents.json
config/*.bak
config/logs/
.DS_Store

# Test artefacts
.pytest_cache/
tests/__pycache__/

# Local test virtualenv
.venv*/

# Backup files are not source control. Six of these were tracked for months and
# drifted out of date; git already keeps every previous version.
*.backup
*.backup*
*.bak
*.orig
