# Motorsportarr Environment Variables
# ================================
# These override settings.yml. Copy to .env and fill in your values.
#
# The authoritative list is generated from the code - if a variable is missing
# from there it is not read:
#     python -m utils.config_loader --env-help

# Prowlarr
PROWLARR_URL=http://192.168.1.100:9696
PROWLARR_API_KEY=your_prowlarr_api_key

# SABnzbd
SABNZBD_URL=http://192.168.1.100:8080
SABNZBD_API_KEY=your_sabnzbd_api_key

# Plex
PLEX_URL=http://192.168.1.100:32400
PLEX_TOKEN=your_plex_token
PLEX_LIBRARY_ID=16
PLEX_LIBRARY_NAME=Motorsport - MotoGP

# Path Mapping (container path -> Plex path)
# Both are required. Plex reports paths as its own container sees them, and
# matching is by exact string, so without this tagging silently never matches.
PLEX_PATH_CONTAINER=/media
PLEX_PATH_PLEX=/data/media

# Paths (as seen inside this container)
MOTOGP_LIBRARY_PATH=/media/Motorsport/MotoGP
MOTOGP_DOWNLOADS_PATH=/downloads/complete/motogp

# Discord (optional)
DISCORD_WEBHOOK_URL=

# Timezone
TZ=Europe/London

# ---------------------------------------------------------------------------
# Authentication (Cloudflare Access)
# ---------------------------------------------------------------------------
# The WebUI verifies the Cf-Access-Jwt-Assertion token itself, because anything
# on the LAN or the Docker network can reach port 5679 without going through
# Cloudflare. Set ALL THREE, or none of them (none = unauthenticated, warned at
# startup and in the UI).
#
#   Issuer:   https://<team>.cloudflareaccess.com
#   Audience: the Access application's AUD tag
#
# A verified email that is not in AUTH_ALLOWED_EMAILS is denied. There is no
# sign-up and no user management: this list is the whole permission model.
#AUTH_ISSUER=
#AUTH_AUDIENCE=
#AUTH_ALLOWED_EMAILS=you@example.com

# Optional override (defaults to $AUTH_ISSUER/cdn-cgi/access/certs)
#AUTH_CERTS_URL=

# cloudflare (require a token, fail closed) | none (disable auth - LAN only)
#AUTH_MODE=
